FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN if command -v apk >/dev/null 2>&1; then apk add --no-cache build-base linux-headers; fi

RUN python -m pip install --no-cache-dir uv -i https://pypi.tuna.tsinghua.edu.cn/simple

COPY word_select_dashboard/word-agent/pyproject.toml word_select_dashboard/word-agent/uv.lock word_select_dashboard/word-agent/README.md ./
COPY word_select_dashboard/word-agent/src ./src
RUN uv sync --frozen --no-dev
