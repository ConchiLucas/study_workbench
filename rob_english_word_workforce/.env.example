# Copy this file to .env.local and edit only that private file.

# select_english_word PostgreSQL
SELECT_DB_HOST=127.0.0.1
SELECT_DB_PORT=5432
SELECT_DB_NAME=select_english_word
SELECT_DB_USER=change-me
SELECT_DB_PASSWORD=change-me
SELECT_DB_SSLMODE=disable

# rob_english_word PostgreSQL
ROB_WORD_DB_HOST=127.0.0.1
ROB_WORD_DB_PORT=5432
ROB_WORD_DB_NAME=rob_english_word
ROB_WORD_DB_USER=change-me
ROB_WORD_DB_PASSWORD=change-me
ROB_WORD_DB_SSLMODE=disable

# Redis (password may be empty)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_HOST=127.0.0.1
MINIO_PORT=19100
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=ai-file-navigation
MINIO_USE_SSL=false

# Optional local CLI executable overrides
CODEX_COMMAND_PATH=
GEMINI_COMMAND_PATH=

# Service ports
ROB_WORD_HTTP_PORT=10111
ROB_WORD_WEBSOCKET_PORT=10112
ROB_WORD_FRONT_PORT=6111
CLOZE_WEB_PORT=6014
DASHBOARD_SERVER_PORT=6015
DASHBOARD_WEB_PORT=6016
WORD_AGENT_PORT=6017
CLI_RUNNER_PORT=6018

